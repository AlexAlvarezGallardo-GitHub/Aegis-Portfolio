---
import Section from './Section.astro';
import Mermaid from './Mermaid.astro';
import { aiAgents } from '../data/site';

const pipeline = `
flowchart TB
    BR["Business Requirement"]
    SA["Specification Agent\\n(write-spec)"]
    AR["Architecture Agent\\n(architect)"]
    PL["Planning Agent\\n(plan)"]
    SB["Service Builder Agent\\n(service-builder)"]
    FB["Frontend Builder Agent\\n(frontend-builder)"]
    TE["Test Engineer Agent\\n(test-engineer)"]
    IE["Infrastructure Agent\\n(infra-engineer)"]
    RV["Review Agents\\n(code-reviewer, security-reviewer)"]
    IM["Issue Manager Agent\\n(issue-manager)"]
    PROD["Production-Ready Service"]

    BR --> SA
    SA --> AR
    AR --> PL
    PL --> SB & FB & TE & IE
    SB & FB & TE & IE --> RV
    RV --> IM
    IM --> PROD

    style BR fill:#18181b,stroke:#d4af37
    style PROD fill:#18181b,stroke:#e6c15a,stroke-width:2px
`;
---

<Section
  id="ai"
  eyebrow="AI Platform"
  title="AI as architecture, not an API call"
  subtitle="Aegis is built by orchestrating a team of specialized AI agents under human direction. Each agent owns a discipline, a skill set and a quality bar — together they form a virtual engineering organization."
>
  <div class="reveal mt-10">
    <Mermaid code={pipeline} title="Agent orchestration pipeline" />
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      aiAgents.map((agent, i) => (
        <div
          class="reveal rounded-xl border border-white/5 bg-card p-5"
          style={`transition-delay: ${(i % 4) * 60}ms`}
        >
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-primary">
            {agent.role}
          </p>
          <h3 class="mt-2 font-display text-sm font-semibold text-foreground">{agent.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{agent.task}</p>
        </div>
      ))
    }
  </div>

  <div class="reveal mt-10 rounded-xl border border-white/5 bg-surface/60 p-8">
    <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
      The paradigm shift
    </h3>
    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      <div>
        <h4 class="font-display text-sm font-semibold text-muted">Traditional development</h4>
        <p class="mt-3 font-mono text-sm leading-relaxed text-muted">
          analyst → architect → developer → tester → devops
        </p>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li>· Each handoff loses context and introduces delay</li>
          <li>· Documentation is an afterthought</li>
          <li>· Teams of 5–10 people</li>
        </ul>
      </div>
      <div>
        <h4 class="font-display text-sm font-semibold text-accent">Aegis approach</h4>
        <p class="mt-3 font-mono text-sm leading-relaxed text-accent">
          spec → architecture → build → test → review → manage
        </p>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li>· Specialized agents work in parallel with built-in quality gates</li>
          <li>· Specs, contracts and ADRs generated alongside code</li>
          <li>· One person directs the virtual team</li>
        </ul>
      </div>
    </div>
  </div>
</Section>
