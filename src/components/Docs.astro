---
import Section from './Section.astro';

const base = import.meta.env.BASE_URL;

const docs = [
  {
    title: 'Architecture',
    description: 'Hexagonal architecture, event-driven flows and the reasoning behind them.',
    href: `${base}docs/architecture`,
    tag: 'Architecture',
  },
  {
    title: 'Architecture Decision Records',
    description: 'Every significant decision documented with context, decision and consequences.',
    href: `${base}docs/adr`,
    tag: 'ADRs',
  },
  {
    title: 'API Reference',
    description: 'Spec-first OpenAPI contracts for every service.',
    href: `${base}docs/api`,
    tag: 'OpenAPI',
  },
  {
    title: 'Coding Standards',
    description: 'Conventions, checkstyle rules and architecture enforcement.',
    href: `${base}docs/coding-standards`,
    tag: 'Standards',
  },
  {
    title: 'Development Setup',
    description: 'Local environment, Docker Compose and how to run the full stack.',
    href: `${base}docs/setup`,
    tag: 'Setup',
  },
  {
    title: 'Deployment Guide',
    description: 'GitOps delivery model — how code becomes running infrastructure.',
    href: `${base}docs/deployment`,
    tag: 'GitOps',
  },
  {
    title: 'Roadmap',
    description: 'What has shipped, what is in flight and where the platform is going.',
    href: `${base}docs/roadmap`,
    tag: 'Roadmap',
  },
];
---

<Section
  id="documentation"
  eyebrow="Documentation"
  title="Engineering discipline"
  subtitle="The repository is the documentation. Specs, contracts, ADRs and operational guides live alongside the code — always current, always consistent."
>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      docs.map((doc, i) => (
        <a
          href={doc.href}
          class="reveal group rounded-xl border border-white/5 bg-card p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/40"
          style={`transition-delay: ${(i % 3) * 60}ms`}
        >
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs uppercase tracking-widest text-primary">{doc.tag}</span>
            <svg class="h-4 w-4 text-muted transition-transform group-hover:translate-x-1 group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="mt-3 font-display text-lg font-semibold text-foreground">{doc.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{doc.description}</p>
        </a>
      ))
    }
  </div>
</Section>
