---
import Section from './Section.astro';
import { getDashboardData } from '../lib/github';

const metrics = getDashboardData();

const available = metrics !== null;

const statusColor = (conclusion: string) => {
  if (conclusion === 'success') return 'text-emerald-400 border-emerald-400/30 bg-emerald-400/10';
  if (conclusion === 'failure') return 'text-red-400 border-red-400/30 bg-red-400/10';
  if (conclusion === 'neutral' || !conclusion) return 'text-muted border-white/10 bg-white/5';
  return 'text-accent border-accent/30 bg-accent/10';
};

const formatDate = (iso: string | null) => {
  if (!iso) return '—';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toISOString().slice(0, 10);
};
---

<Section
  id="dashboard"
  eyebrow="Engineering Dashboard"
  title="Live evidence of engineering practice"
  subtitle="Real data from the Aegis repository. Metrics, pull requests, releases and CI/CD pipeline status — not static claims."
>
  <div class="mt-10">
    {available ? (
      <div class="flex items-center gap-2">
        <span
          class="inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs border-emerald-400/30 bg-emerald-400/10 text-emerald-400"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
          Connected to GitHub API
        </span>
        <a
          href="https://github.com/AlexAlvarezGallardo-GitHub/Aegis"
          target="_blank"
          rel="noreferrer"
          class="font-mono text-xs text-muted transition-colors hover:text-accent"
        >
          github.com/AlexAlvarezGallardo-GitHub/Aegis →
        </a>
      </div>
    ) : (
      <div class="flex items-center gap-2">
        <span
          class="inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs border-accent/30 bg-accent/10 text-accent"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
          Metrics temporarily unavailable
        </span>
        <a
          href="https://github.com/AlexAlvarezGallardo-GitHub/Aegis"
          target="_blank"
          rel="noreferrer"
          class="font-mono text-xs text-muted transition-colors hover:text-accent"
        >
          github.com/AlexAlvarezGallardo-GitHub/Aegis →
        </a>
      </div>
    )}

    {available ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="reveal rounded-xl border border-white/5 bg-card p-6">
          <p class="font-mono text-xs uppercase tracking-widest text-muted">Commits</p>
          <p class="counter mt-2 font-display text-4xl font-bold text-foreground" data-target={metrics.commitCount}>
            0
          </p>
        </div>
        <div class="reveal rounded-xl border border-white/5 bg-card p-6">
          <p class="font-mono text-xs uppercase tracking-widest text-muted">Open PRs</p>
          <p class="counter mt-2 font-display text-4xl font-bold text-foreground" data-target={metrics.openPullRequests}>
            0
          </p>
        </div>
        <div class="reveal rounded-xl border border-white/5 bg-card p-6">
          <p class="font-mono text-xs uppercase tracking-widest text-muted">Closed PRs</p>
          <p class="counter mt-2 font-display text-4xl font-bold text-foreground" data-target={metrics.closedPullRequests}>
            0
          </p>
        </div>
        <div class="reveal rounded-xl border border-white/5 bg-card p-6">
          <p class="font-mono text-xs uppercase tracking-widest text-muted">Last commit</p>
          <p class="mt-2 font-display text-3xl font-bold text-foreground">{formatDate(metrics.lastCommit)}</p>
        </div>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="reveal rounded-xl border border-white/5 bg-card p-6">
          <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
            Latest release
          </h3>
          <div class="mt-4">
            {metrics.latestRelease ? (
              <a
                href={`https://github.com/AlexAlvarezGallardo-GitHub/Aegis/releases/tag/${metrics.latestRelease}`}
                target="_blank"
                rel="noreferrer"
                class="font-mono text-sm text-accent transition-colors hover:text-foreground"
              >
                {metrics.latestRelease}
              </a>
            ) : (
              <p class="text-sm text-muted">No releases published yet.</p>
            )}
          </div>
        </div>

        <div class="reveal rounded-xl border border-white/5 bg-card p-6">
          <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
            CI/CD pipeline
          </h3>
          <div class="mt-4 space-y-3">
            <div class="flex items-center justify-between gap-3">
              <span class="truncate text-sm text-foreground">Last CI run</span>
              <span
                class:list={[
                  'inline-flex shrink-0 items-center rounded-full border px-2.5 py-0.5 font-mono text-xs',
                  statusColor(metrics.ciStatus),
                ]}
              >
                {metrics.ciStatus === 'no runs yet' ? 'no runs yet' : metrics.ciStatus}
              </span>
            </div>
            {metrics.lastCiRun && (
              <div class="flex items-center justify-between gap-3 text-sm">
                <span class="text-muted">When</span>
                <span class="font-mono text-xs text-muted">{formatDate(metrics.lastCiRun)}</span>
              </div>
            )}
          </div>
        </div>
      </div>

      <div class="mt-6 reveal rounded-xl border border-white/5 bg-card p-6">
        <div class="flex items-center justify-between gap-3 text-sm">
          <span class="text-muted">Metrics generated</span>
          <span class="font-mono text-xs text-muted">{formatDate(metrics.generatedAt)}</span>
        </div>
      </div>
    ) : (
      <p class="mt-8 text-sm text-muted">
        Metrics are temporarily unavailable. They appear here as soon as the
        dashboard can reach the GitHub API.
      </p>
    )}
  </div>
</Section>
