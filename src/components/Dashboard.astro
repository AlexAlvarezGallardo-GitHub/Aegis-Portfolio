---
import Section from './Section.astro';
import { getDashboardData } from '../lib/github';

const data = await getDashboardData();

const stats = data.live
  ? [
      { label: 'Commits', value: data.commits },
      { label: 'Pull Requests', value: data.pulls },
      { label: 'Open Issues', value: data.openIssues || data.issues },
      { label: 'Stars', value: data.repo.stars },
    ]
  : [];

const statusColor = (conclusion: string) => {
  if (conclusion === 'success') return 'text-emerald-400 border-emerald-400/30 bg-emerald-400/10';
  if (conclusion === 'failure') return 'text-red-400 border-red-400/30 bg-red-400/10';
  if (conclusion === 'neutral' || !conclusion) return 'text-muted border-white/10 bg-white/5';
  return 'text-accent border-accent/30 bg-accent/10';
};
---

<Section
  id="dashboard"
  eyebrow="Engineering Dashboard"
  title="Live evidence of engineering practice"
  subtitle="Real data from the Aegis repository. Metrics, pull requests, releases and CI/CD pipeline status — not static claims."
>
  <div class="mt-10">
    <div class="flex items-center gap-2">
      <span
        class:list={[
          'inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs',
          data.live
            ? 'border-emerald-400/30 bg-emerald-400/10 text-emerald-400'
            : 'border-accent/30 bg-accent/10 text-accent',
        ]}
      >
        <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
        {data.live
          ? 'Connected to GitHub API'
          : 'Metrics temporarily unavailable'}
      </span>
      <a
        href={data.repo.htmlUrl}
        target="_blank"
        rel="noreferrer"
        class="font-mono text-xs text-muted transition-colors hover:text-accent"
      >
        github.com/AlexAlvarezGallardo-GitHub/Aegis →
      </a>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        data.live ? (
          stats.map((stat) => (
            <div class="reveal rounded-xl border border-white/5 bg-card p-6">
              <p class="font-mono text-xs uppercase tracking-widest text-muted">{stat.label}</p>
              <p class="counter mt-2 font-display text-4xl font-bold text-foreground" data-target={stat.value}>
                0
              </p>
            </div>
          ))
        ) : (
          <div class="rounded-xl border border-white/5 bg-card p-6 sm:col-span-2 lg:col-span-4">
            <p class="text-sm text-muted">
              Metrics are temporarily unavailable. They appear here as soon as the dashboard can
              reach the GitHub API.
            </p>
          </div>
        )
      }
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="reveal rounded-xl border border-white/5 bg-card p-6">
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
          Latest releases
        </h3>
        {data.live && data.releases.length ? (
          <ul class="mt-4 divide-y divide-white/5">
            {
              data.releases.map((release) => (
                <li class="flex items-center justify-between py-3">
                  <div>
                    <a
                      href={release.url}
                      target="_blank"
                      rel="noreferrer"
                      class="font-mono text-sm text-accent transition-colors hover:text-foreground"
                    >
                      {release.tag}
                    </a>
                    <p class="text-sm text-muted">{release.name}</p>
                  </div>
                  <span class="font-mono text-xs text-muted">
                    {release.date ? release.date.slice(0, 10) : ''}
                  </span>
                </li>
              ))
            }
          </ul>
        ) : (
          <p class="mt-4 text-sm text-muted">
            Releases are shown here when connected to the GitHub API.
          </p>
        )}
      </div>

      <div class="reveal rounded-xl border border-white/5 bg-card p-6">
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
          CI/CD pipeline
        </h3>
        {data.workflows.length ? (
          <ul class="mt-4 divide-y divide-white/5">
            {
              data.workflows.map((run) => (
                <li class="flex items-center justify-between gap-3 py-3">
                  <span class="truncate text-sm text-foreground">{run.name}</span>
                  <span
                    class:list={[
                      'inline-flex shrink-0 items-center rounded-full border px-2.5 py-0.5 font-mono text-xs',
                      statusColor(run.conclusion),
                    ]}
                  >
                    {run.status === 'completed' ? run.conclusion || 'completed' : run.status}
                  </span>
                </li>
              ))
            }
          </ul>
        ) : (
          <p class="mt-4 text-sm text-muted">
            Pipeline runs are displayed here when connected to the GitHub API.
          </p>
        )}
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <div class="reveal rounded-xl border border-white/5 bg-card p-6">
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
          Language distribution
        </h3>
        {data.languages.length ? (
          <div class="mt-4 space-y-3">
            {
              data.languages.map((lang) => (
                <div>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-foreground">{lang.name}</span>
                    <span class="font-mono text-xs text-muted">{lang.percent}%</span>
                  </div>
                  <div class="mt-1 h-1.5 w-full rounded-full bg-white/5">
                    <div
                      class="h-1.5 rounded-full bg-gradient-to-r from-primary to-accent"
                      style={`width: ${lang.percent}%`}
                    ></div>
                  </div>
                </div>
              ))
            }
          </div>
        ) : (
          <p class="mt-4 text-sm text-muted">
            Java is the primary language — the distribution is shown here when connected.
          </p>
        )}
      </div>

      <div class="reveal rounded-xl border border-white/5 bg-card p-6">
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
          Repository
        </h3>
        <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-4">
          <div>
            <dt class="font-mono text-xs uppercase tracking-widest text-muted">Language</dt>
            <dd class="mt-1 font-mono text-sm text-foreground">{data.repo.language}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-widest text-muted">Default branch</dt>
            <dd class="mt-1 font-mono text-sm text-foreground">{data.repo.defaultBranch}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-widest text-muted">Forks</dt>
            <dd class="mt-1 font-mono text-sm text-foreground">{data.repo.forks}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-widest text-muted">Watchers</dt>
            <dd class="mt-1 font-mono text-sm text-foreground">{data.repo.watchers}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</Section>
