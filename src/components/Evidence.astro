---
import Section from './Section.astro';
import { evidenceGroups, evidenceSource, loadTest } from '../data/evidence';

const base = import.meta.env.BASE_URL;
---

<Section
  id="evidence"
  eyebrow="Evidence"
  title="The platform, in action"
  subtitle="Screenshots captured from the running stack — not mockups. The application was stood up locally (minikube + Aegis-GitOps), exercised end-to-end, and its traces, events and metrics collected from the real observability stack."
>
  {
    evidenceGroups.map((group) => (
      <div class="reveal mt-12">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="font-display text-lg font-semibold text-foreground">{group.label}</h3>
          <p class="font-mono text-xs text-muted">{group.note}</p>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            group.items.map((item) => (
              <button
                type="button"
                aria-haspopup="dialog"
                class="evidence-card group overflow-hidden rounded-xl border border-white/5 bg-card text-left transition-colors hover:border-primary/50"
                data-evidence-src={`${base}${item.src}`}
                data-evidence-title={item.title}
                data-evidence-caption={item.caption}
              >
                <img
                  src={`${base}${item.src}`}
                  alt={item.title}
                  loading="lazy"
                  class="aspect-video w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]"
                />
                <div class="p-4">
                  <p class="font-display text-sm font-semibold text-foreground">{item.title}</p>
                  <p class="mt-1 line-clamp-2 text-sm text-muted">{item.caption}</p>
                </div>
              </button>
            ))
          }
        </div>
      </div>
    ))
  }

  <div class="reveal mt-12 rounded-xl border border-white/5 bg-surface/60 p-6">
    <p class="text-sm leading-relaxed text-muted">
      Every capture above is reproducible — the evidence lives in the
      <a
        href={evidenceSource.href}
        target="_blank"
        rel="noreferrer"
        class="text-accent transition-colors hover:text-foreground"
      >
        {' '}evidence{ ' '}
      </a>
      folder of the repository, including the
      <a
        href={loadTest.href}
        target="_blank"
        rel="noreferrer"
        class="text-accent transition-colors hover:text-foreground"
      >
        {' '}load-test results{ ' '}
      </a>
      (40/40 concurrent deposits, p95 247 ms — within the 400 ms SLO) and raw Tempo traces.
    </p>
  </div>
</Section>
