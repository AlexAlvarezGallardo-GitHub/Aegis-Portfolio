---
import Section from './Section.astro';
import { observability } from '../data/site';
---

<Section
  id="observability"
  eyebrow="Observability"
  title="Operational maturity"
  subtitle="Every service is instrumented with OpenTelemetry. Metrics, traces and logs flow to a shared stack — because you can't operate what you can't see."
>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      observability.map((item, i) => (
        <div
          class="reveal rounded-xl border border-white/5 bg-card p-6"
          style={`transition-delay: ${(i % 3) * 60}ms`}
        >
          <h3 class="font-display text-lg font-semibold text-foreground">{item.name}</h3>
          <p class="mt-1 font-mono text-sm text-accent">{item.tool}</p>
        </div>
      ))
    }
  </div>

  <div class="reveal mt-10 rounded-xl border border-white/5 bg-surface/60 p-8">
    <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
      Telemetry pipeline
    </h3>
    <p class="mt-4 font-mono text-sm leading-loose text-muted">
      Spring Services{" "}
      <span class="text-accent">─── OpenTelemetry SDK ───▶</span> OTLP Exporter{" "}
      <span class="text-accent">───▶</span> Prometheus · Tempo · Loki{" "}
      <span class="text-accent">───▶</span> Grafana
    </p>
    <p class="mt-4 text-sm leading-relaxed text-muted">
      Distributed tracing follows every request across microservices, structured logs are
      centralized, and metrics feed dashboards and alerts — production diagnostics, not guesswork.
    </p>
  </div>
</Section>
