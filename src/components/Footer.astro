---
const base = import.meta.env.BASE_URL;

const nav = [
  { href: `${base}#platform`, label: 'Platform' },
  { href: `${base}#architecture`, label: 'Architecture' },
  { href: `${base}#engineering`, label: 'Engineering' },
  { href: `${base}#ai`, label: 'AI Platform' },
  { href: `${base}#infrastructure`, label: 'Infrastructure' },
  { href: `${base}#security`, label: 'Security' },
];

const docs = [
  { href: `${base}docs/architecture`, label: 'Architecture' },
  { href: `${base}docs/adr`, label: 'ADRs' },
  { href: `${base}docs/api`, label: 'API' },
  { href: `${base}docs/coding-standards`, label: 'Coding Standards' },
  { href: `${base}docs/setup`, label: 'Development Setup' },
  { href: `${base}docs/deployment`, label: 'Deployment' },
  { href: `${base}docs/roadmap`, label: 'Roadmap' },
];
---

<footer class="border-t border-white/5 bg-surface/40">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <div class="flex items-center gap-2.5">
          <img src={`${base}aegis-icon.png`} alt="Aegis" width="32" height="32" class="h-8 w-8 rounded-md object-cover" />
          <span class="font-display text-base font-semibold tracking-tight">Aegis</span>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          A public demonstration of software engineering, architecture, DevOps, AI
          integration and product thinking — built as a production-oriented financial
          reference architecture.
        </p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
          Platform
        </h3>
        <ul class="mt-4 space-y-2">
          {
            nav.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-muted transition-colors hover:text-accent">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
          Documentation
        </h3>
        <ul class="mt-4 space-y-2">
          {
            docs.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-muted transition-colors hover:text-accent">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 sm:flex-row">
      <p class="text-xs text-muted">
        Built by orchestrating AI agents · Enterprise-grade from day one · Business-first,
        technology-second
      </p>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/AlexAlvarezGallardo-GitHub"
          target="_blank"
          rel="noreferrer"
          class="text-xs text-muted transition-colors hover:text-accent"
        >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/alexalvarezgallardo/"
          target="_blank"
          rel="noreferrer"
          class="text-xs text-muted transition-colors hover:text-accent"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</footer>
