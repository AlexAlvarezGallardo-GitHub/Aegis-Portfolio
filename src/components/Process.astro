---
import Section from './Section.astro';

const stats = [
  { label: 'Weeks from zero to platform', value: 6.3, decimals: 1, prefix: '', suffix: '' },
  { label: 'Commits', value: 141, decimals: 0, prefix: '', suffix: '' },
  { label: 'Feature branches', value: 41, decimals: 0, prefix: '', suffix: '' },
  { label: 'Microservices', value: 6, decimals: 0, prefix: '', suffix: '' },
  { label: 'Specs & contracts', value: 8, decimals: 0, prefix: '', suffix: '' },
  { label: 'ADRs', value: 12, decimals: 0, prefix: '', suffix: '' },
];

const phases = [
  {
    period: 'Jun 23 – Jun 30',
    label: 'Phase 01 — Foundation',
    commits: '14 commits',
    points: [
      'Engineering conventions and the architectural constitution',
      'First specifications (001–004) with OpenAPI contracts',
      'CI/CD scaffolding and quality gates',
      'ADR-003: defer Kubernetes until platform maturity',
    ],
    knowledge: 'Architecture principles, spec-first discipline',
  },
  {
    period: 'Jul 1 – Jul 31',
    label: 'Phase 02 — Core platform',
    commits: '107 commits',
    points: [
      'Identity, BFF, Wallet, Audit and Reporting services',
      'Transactional outbox on Kafka with reliable delivery',
      'Angular frontend and session-based security',
      'Four parallel CI quality gates',
    ],
    knowledge: 'Hexagonal boundaries, event-driven design, session security',
  },
  {
    period: 'Aug 1 – Aug 5',
    label: 'Phase 03 — Operations',
    commits: '48 commits',
    points: [
      'GitOps foundation with Argo CD',
      'Helm charts and environment overlays',
      'Observability stack — OpenTelemetry, Tempo, Prometheus, Loki',
      'Supply-chain security — Trivy, CodeQL, Cosign, SBOM',
    ],
    knowledge: 'Production operations, GitOps, telemetry, supply chain',
  },
  {
    period: 'Ongoing',
    label: 'Phase 04 — Knowledge transfer',
    commits: 'continuous',
    points: [
      'Obsidian vault with architecture and event documentation',
      'ADRs and Mermaid diagrams for every decision',
      'This engineering portfolio',
    ],
    knowledge: 'Communication — turning work into reusable knowledge',
  },
];

const loop = [
  { step: '01', title: 'Specify', text: 'Every feature starts as an unambiguous spec with contracts.' },
  { step: '02', title: 'Validate', text: 'Architecture agents check every line against the constitution.' },
  { step: '03', title: 'Build', text: 'Specialized agents build service, frontend, tests and infra in parallel.' },
  { step: '04', title: 'Gate', text: 'Branch naming, commits, PR titles and bodies are enforced automatically.' },
  { step: '05', title: 'Document', text: 'ADRs, contracts and diagrams are generated alongside code.' },
  { step: '06', title: 'Compound', text: 'Knowledge from one feature becomes the starting point of the next.' },
];
---

<Section
  id="process"
  eyebrow="Process & Velocity"
  title="Built in six weeks — by design, not by accident"
  subtitle="The timeline below is real. Six weeks from first commit to a financial reference platform with GitOps delivery, observability and a secure supply chain. The process is the product."
>
  <div class="mt-10 grid gap-4 sm:grid-cols-3 lg:grid-cols-6">
    {
      stats.map((stat, i) => (
        <div
          class="reveal rounded-xl border border-white/5 bg-card p-5"
          style={`transition-delay: ${(i % 3) * 60}ms`}
        >
          <p class="font-mono text-xs uppercase tracking-widest text-muted">{stat.label}</p>
          <p
            class="counter mt-2 font-display text-3xl font-bold text-foreground"
            data-target={stat.value}
            data-decimals={stat.decimals}
            data-prefix={stat.prefix}
            data-suffix={stat.suffix}
          >
            0
          </p>
        </div>
      ))
    }
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-[1fr_340px]">
    <div class="relative space-y-8 border-l border-white/10 pl-8">
      {
        phases.map((phase, i) => (
          <div class="reveal relative" style={`transition-delay: ${i * 60}ms`}>
            <span class="absolute -left-[2.3rem] top-1 h-4 w-4 rounded-full border-2 border-primary bg-background"></span>
            <div class="flex flex-wrap items-center gap-3">
              <p class="font-mono text-xs uppercase tracking-widest text-primary">{phase.period}</p>
              <span class="rounded-full border border-white/10 bg-card px-2.5 py-0.5 font-mono text-xs text-muted">
                {phase.commits}
              </span>
            </div>
            <h3 class="mt-2 font-display text-xl font-semibold text-foreground">{phase.label}</h3>
            <ul class="mt-3 space-y-1.5">
              {
                phase.points.map((p) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted">
                    <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {p}
                  </li>
                ))
              }
            </ul>
            <p class="mt-3 border-l-2 border-primary/40 pl-3 text-xs italic text-muted">
              Knowledge gained: {phase.knowledge}
            </p>
          </div>
        ))
      }
    </div>

    <div class="reveal space-y-6">
      <div class="rounded-xl border border-white/5 bg-card p-6">
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-foreground">
          The knowledge loop
        </h3>
        <ol class="mt-4 space-y-4">
          {
            loop.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 font-mono text-sm font-bold text-primary">{item.step}</span>
                <div>
                  <p class="text-sm font-semibold text-foreground">{item.title}</p>
                  <p class="mt-0.5 text-sm text-muted">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="rounded-xl border border-primary/30 bg-primary/5 p-6">
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-accent">
          The velocity gap
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          {`What a traditional fintech team of 5–8 engineers would schedule across multiple
          quarters, Aegis delivered in six weeks. Not by skipping rigor — but by making rigor
          automatic.`}
        </p>
      </div>
    </div>
  </div>
</Section>
