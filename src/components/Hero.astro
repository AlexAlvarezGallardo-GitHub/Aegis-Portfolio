---
const base = import.meta.env.BASE_URL;
const github = 'https://github.com/AlexAlvarezGallardo-GitHub/Aegis';
---

<section class="relative overflow-hidden border-b border-white/5">
  <div class="bg-grid pointer-events-none absolute inset-0"></div>
  <div class="glow-primary pointer-events-none absolute inset-x-0 -top-40 h-[480px]"></div>

  <div class="relative mx-auto max-w-6xl px-4 pt-24 pb-16 sm:px-6 sm:pt-32 sm:pb-24">
    <div class="grid items-center gap-14 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p
          class="hero-entrance mb-6 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-accent"
          style="opacity: 0"
        >
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary"></span>
          Agent-Orchestrated · Production-Oriented
        </p>

        <h1
          class="hero-entrance font-display text-5xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl"
          style="opacity: 0"
        >
          AI-Orchestrated{" "}
          <span class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">
            Financial Reference Architecture
          </span>
        </h1>

        <p
          class="hero-entrance mt-6 max-w-xl text-lg leading-relaxed text-muted"
          style="opacity: 0"
        >
          {`A production-oriented financial reference architecture built with modern cloud
          architecture, distributed systems and AI-assisted engineering. Designed, specified,
          built and operated with the rigor of a real engineering platform.`}
        </p>

        <div
          class="hero-entrance mt-8 flex flex-wrap items-center gap-4"
          style="opacity: 0"
        >
          <a
            href={`${base}#platform`}
            class="rounded-md bg-gradient-to-br from-primary to-accent px-5 py-2.5 font-semibold text-background transition-shadow hover:shadow-[0_0_30px_rgba(212,175,55,0.45)]"
          >
            Explore the platform
          </a>
          <a
            href={github}
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-2 rounded-md border border-white/10 px-5 py-2.5 font-semibold text-foreground transition-colors hover:border-primary/60 hover:text-accent"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.8.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
              />
            </svg>
            View on GitHub
          </a>
        </div>

        <dl
          class="hero-entrance mt-10 grid max-w-lg grid-cols-3 gap-6 border-t border-white/5 pt-6"
          style="opacity: 0"
        >
          <div>
            <dt class="font-mono text-xs uppercase tracking-widest text-muted">Services</dt>
            <dd class="mt-1 font-display text-2xl font-bold">
              <span class="counter" data-target="6">0</span>
            </dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-widest text-muted">Bounded contexts</dt>
            <dd class="mt-1 font-display text-2xl font-bold">1:1</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-widest text-muted">Quality gates</dt>
            <dd class="mt-1 font-display text-2xl font-bold">
              <span class="counter" data-target="4">0</span>
            </dd>
          </div>
        </dl>
      </div>

      <div class="hero-entrance relative hidden lg:block" style="opacity: 0">
        <div class="relative rounded-2xl border border-white/5 bg-surface/60 p-6">
          <div class="absolute inset-0 bg-grid rounded-2xl"></div>
          <div class="relative aspect-square w-full">
            <svg viewBox="0 0 420 440" class="h-full w-full">
              <defs>
                <marker id="arrow-request" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M0,0 L10,5 L0,10 z" fill="#d4af37" />
                </marker>
                <marker id="arrow-event" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M0,0 L10,5 L0,10 z" fill="#e6c15a" />
                </marker>
              </defs>

            <g stroke="#d4af37" stroke-width="1.6" marker-end="url(#arrow-request)">
              <line x1="210" y1="72" x2="210" y2="103" />
              <line x1="150" y1="125" x2="138" y2="190" />
              <line x1="270" y1="125" x2="282" y2="190" />
            </g>

            <g class="event-line" stroke="#e6c15a" stroke-width="1.4" stroke-dasharray="6 5" marker-end="url(#arrow-event)">
              <line x1="78" y1="212" x2="196" y2="222" />
              <line x1="342" y1="212" x2="224" y2="222" />
              <line x1="200" y1="263" x2="90" y2="308" />
              <line x1="210" y1="263" x2="210" y2="328" />
              <line x1="220" y1="263" x2="330" y2="308" />
            </g>

            <g class="animate-pulse">
              <rect x="150" y="28" width="120" height="44" rx="8" fill="#18181b" stroke="#d4af37" stroke-width="1.5" />
              <text x="210" y="50" text-anchor="middle" fill="#fafafa" font-size="11" font-family="JetBrains Mono, monospace">Angular</text>
              <text x="210" y="64" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="JetBrains Mono, monospace">Frontend</text>

              <rect x="150" y="103" width="120" height="44" rx="8" fill="#18181b" stroke="#d4af37" stroke-width="1.5" />
              <text x="210" y="125" text-anchor="middle" fill="#fafafa" font-size="11" font-family="JetBrains Mono, monospace">BFF</text>
              <text x="210" y="139" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="JetBrains Mono, monospace">Gateway</text>

              <rect x="18" y="168" width="120" height="44" rx="8" fill="#18181b" stroke="#d4af37" stroke-width="1.5" />
              <text x="78" y="190" text-anchor="middle" fill="#fafafa" font-size="11" font-family="JetBrains Mono, monospace">Identity</text>
              <text x="78" y="204" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="JetBrains Mono, monospace">Service</text>

              <rect x="282" y="168" width="120" height="44" rx="8" fill="#18181b" stroke="#d4af37" stroke-width="1.5" />
              <text x="342" y="190" text-anchor="middle" fill="#fafafa" font-size="11" font-family="JetBrains Mono, monospace">Wallet</text>
              <text x="342" y="204" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="JetBrains Mono, monospace">Service</text>

              <rect x="30" y="308" width="120" height="44" rx="8" fill="#18181b" stroke="#d4af37" stroke-width="1.5" />
              <text x="90" y="330" text-anchor="middle" fill="#fafafa" font-size="11" font-family="JetBrains Mono, monospace">Fraud</text>
              <text x="90" y="344" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="JetBrains Mono, monospace">Detection</text>

              <rect x="150" y="328" width="120" height="44" rx="8" fill="#18181b" stroke="#d4af37" stroke-width="1.5" />
              <text x="210" y="350" text-anchor="middle" fill="#fafafa" font-size="11" font-family="JetBrains Mono, monospace">Audit</text>
              <text x="210" y="364" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="JetBrains Mono, monospace">Service</text>

              <rect x="270" y="308" width="120" height="44" rx="8" fill="#18181b" stroke="#d4af37" stroke-width="1.5" />
              <text x="330" y="330" text-anchor="middle" fill="#fafafa" font-size="11" font-family="JetBrains Mono, monospace">Reporting</text>
              <text x="330" y="344" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="JetBrains Mono, monospace">Service</text>
            </g>

            <circle cx="210" cy="235" r="30" fill="#111113" stroke="#e6c15a" stroke-width="2" class="animate-ping" />
            <circle cx="210" cy="235" r="30" fill="#111113" stroke="#e6c15a" stroke-width="2" />
            <circle cx="210" cy="235" r="9" fill="#e6c15a" class="animate-ping" />
            <circle cx="210" cy="235" r="9" fill="#e6c15a" />
            <text x="210" y="230" text-anchor="middle" fill="#fafafa" font-size="11" font-weight="700" font-family="JetBrains Mono, monospace">Kafka</text>
            <text x="210" y="244" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="JetBrains Mono, monospace">Event Bus</text>
          </svg>
          </div>

          <ul class="relative mt-4 space-y-1.5 border-t border-white/5 pt-4 text-xs text-muted">
            <li class="flex items-center gap-2">
              <span class="inline-block h-2.5 w-2.5 rounded-sm border border-accent bg-surface"></span>
              System / service
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-block h-0 w-6 border-t border-primary"></span>
              Request → the app talks directly to a service
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-block w-6 border-t border-dashed border-accent"></span>
              Event → services share news through Kafka
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-block h-2.5 w-2.5 rounded-full bg-accent"></span>
              Kafka event bus — the pulsing hub in the middle
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'motion';
  animate(
    '.hero-entrance',
    { opacity: [0, 1], y: [20, 0] },
    { duration: 0.7, delay: stagger(0.12), ease: 'easeOut' }
  );
</script>

<style>
  .event-line {
    animation: event-dash 1.4s linear infinite;
  }

  svg circle.animate-ping {
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes event-dash {
    to {
      stroke-dashoffset: -22;
    }
  }
</style>
