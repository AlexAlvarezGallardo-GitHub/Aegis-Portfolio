---
const base = import.meta.env.BASE_URL;

const links = [
  { href: '#platform', label: 'Platform' },
  { href: '#architecture', label: 'Architecture' },
  { href: '#engineering', label: 'Engineering' },
  { href: '#ai', label: 'AI Platform' },
  { href: '#process', label: 'Process' },
  { href: '#infrastructure', label: 'Infrastructure' },
  { href: '#security', label: 'Security' },
  { href: `${base}docs/architecture`, label: 'Documentation' },
  { href: '#roadmap', label: 'Roadmap' },
  { href: '#about', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-background/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={base} class="flex shrink-0 items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-gradient-to-br from-primary to-accent font-mono text-sm font-bold text-background">
        Æ
      </span>
      <span class="font-display text-base font-semibold tracking-tight">Aegis</span>
    </a>

    <div class="hidden min-w-0 shrink-0 items-center gap-x-4 2xl:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="whitespace-nowrap text-sm text-muted transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href="https://github.com/AlexAlvarezGallardo-GitHub"
        target="_blank"
        rel="noreferrer"
        class="hidden items-center gap-2 rounded-md border border-white/10 px-3 py-1.5 text-sm text-foreground transition-colors hover:border-primary/60 hover:text-accent md:flex"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.8.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          />
        </svg>
        GitHub
      </a>
      <a
        href="#platform"
        class="rounded-md bg-gradient-to-br from-primary to-accent px-3 py-1.5 text-sm font-semibold text-background transition-shadow hover:shadow-[0_0_20px_rgba(212,175,55,0.4)]"
      >
        Explore
      </a>
      <button
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-9 w-9 items-center justify-center rounded-md border border-white/10 text-foreground transition-colors hover:border-primary/60 hover:text-accent 2xl:hidden"
      >
        <svg id="menu-open-icon" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg id="menu-close-icon" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-white/5 bg-background/95 backdrop-blur-xl 2xl:hidden">
    <div class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="block rounded-md px-3 py-2 text-sm text-muted transition-colors hover:bg-card hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('button[aria-controls="mobile-menu"]');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  if (button && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    button.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1536) setOpen(false);
    });
  }
</script>
