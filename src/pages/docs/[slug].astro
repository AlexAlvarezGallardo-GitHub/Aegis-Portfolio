---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Layout title={`${doc.data.title} — Aegis`} description={doc.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-primary">
      Documentation
    </p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight">{doc.data.title}</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted">{doc.data.description}</p>
    <div class="prose-aegis mt-10 border-t border-white/5 pt-10">
      <Content />
    </div>
  </article>
</Layout>
