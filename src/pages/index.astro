---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Platform from '../components/Platform.astro';
import Architecture from '../components/Architecture.astro';
import Engineering from '../components/Engineering.astro';
import AI from '../components/AI.astro';
import Process from '../components/Process.astro';
import Infrastructure from '../components/Infrastructure.astro';
import Observability from '../components/Observability.astro';
import Security from '../components/Security.astro';
import Dashboard from '../components/Dashboard.astro';
import Evidence from '../components/Evidence.astro';
import Docs from '../components/Docs.astro';
import Roadmap from '../components/Roadmap.astro';
import About from '../components/About.astro';

const title = 'Aegis — AI-Orchestrated Financial Reference Architecture';
const description =
  'Production-oriented financial reference architecture built with modern cloud architecture, distributed systems and AI-assisted engineering. A portfolio in disguise: this is how enterprise software is built.';
---

<Layout title={title} description={description}>
  <Hero />
  <Platform />
  <Architecture />
  <Engineering />
  <AI />
  <Process />
  <Infrastructure />
  <Observability />
  <Security />
  <Dashboard />
  <Evidence />
  <Docs />
  <Roadmap />
  <About />
</Layout>
